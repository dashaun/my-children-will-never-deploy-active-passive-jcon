{
  "name": "active-passive-presenter",
  "version": "1.0.0",
  "private": true,
  "description": "Serves the JCON deck with a live terminal docked under the demo slides",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
